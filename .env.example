# Standalone mode is the default and exposes a local development administrator.
ACME_AUTH_MODE=off

# In local mode, Acme Steering delegates authentication to Acme Identity.
# ACME_AUTH_MODE=local
# ACME_IDENTITY_URL=http://127.0.0.1:8316

# Optional overrides.
# ACME_STEERING_DATA_DIR=./data
# PORT=8323

# Optional live configuration author. Without a key, the deterministic FakeConfigAgent
# keeps discussion, proposal review, and activation testable offline.
# OPENROUTER_API_KEY=
# ACME_STEERING_MODEL=openrouter/xiaomi/mimo-v2.5-pro
# ACME_STEERING_ADVISOR_MODEL=openrouter/xiaomi/mimo-v2.5-pro

# Optional product-owned action destinations. Tokens are attached only to matching trusted origins.
ACME_STEERING_PRELUDE_URL=
ACME_STEERING_PRELUDE_INSTANCE_ID=default
ACME_STEERING_PRELUDE_TOKEN=
ACME_STEERING_TRUSTED_PRELUDE_ORIGINS=http://127.0.0.1:8318
ACME_STEERING_HELIX_URL=
ACME_STEERING_HELIX_INSTANCE_ID=default
ACME_STEERING_HELIX_TOKEN=
ACME_STEERING_TRUSTED_HELIX_ORIGINS=http://127.0.0.1:8319
ACME_STEERING_ISSUES_URL=
ACME_STEERING_ISSUES_INSTANCE_ID=default
ACME_STEERING_ISSUES_TOKEN=
ACME_STEERING_TRUSTED_ISSUES_ORIGINS=http://127.0.0.1:8320
ACME_STEERING_PROJECTS_URL=
ACME_STEERING_PROJECTS_INSTANCE_ID=default
ACME_STEERING_PROJECTS_TOKEN=
ACME_STEERING_TRUSTED_PROJECTS_ORIGINS=http://127.0.0.1:8321
